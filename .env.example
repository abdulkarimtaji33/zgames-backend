# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api

# Database (XAMPP MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=cgagames

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# AWS S3
AWS_REGION=me-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@cgagames.com

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# URLs
API_URL=http://localhost:3001/api
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# LikeCard (wholesale digital-goods supplier — backend-only, never expose to customers)
LIKECARD_API_URL=https://taxes.like4app.com
LIKECARD_DEVICE_ID=
LIKECARD_EMAIL=
LIKECARD_SECURITY_CODE=
LIKECARD_LANG_ID=1
LIKECARD_HASH_PHONE=
LIKECARD_HASH_KEY=
# Flat % markup applied on top of LikeCard's cost price when syncing catalog prices
LIKECARD_MARKUP_PERCENT=15
# Separate from the auth credentials above — used only to AES-256-CBC decrypt serialCode into the
# real redeemable code. Found in LikeCard's API docs (Create Order/Order Details 200 response
# sections); get the real values from LikeCard integration support if not visible in your portal.
LIKECARD_SECRET_KEY=
LIKECARD_SECRET_IV=
